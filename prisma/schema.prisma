// ════════════════════════════════════════════════════════════════════════
//  VOLTAGE — data model
//  Conventions:
//   • All monetary values are INTEGER PAISE (₹1 = 100). Never floats.
//   • SQLite has no native enums/arrays → enum-ish columns are String,
//     constrained by TS unions in src/lib/enums.ts; list columns are JSON.
// ════════════════════════════════════════════════════════════════════════

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "sqlite"
  url       = env("DATABASE_URL")
}

// ─────────────────────────── AUTH & IDENTITY ───────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  phone         String?   @unique
  passwordHash  String?
  name          String?
  photoUrl      String?
  gender        String?
  dob           DateTime?
  gstin         String? // for B2B invoices

  role        String  @default("customer") // customer | staff | admin
  staffRoleId String?
  staffRole   StaffRole? @relation(fields: [staffRoleId], references: [id])

  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  status          String    @default("active") // active | suspended | deleted

  // Referral identity
  referralCode String  @unique
  referredById String?
  referredBy   User?   @relation("UserReferrals", fields: [referredById], references: [id])
  referees     User[]  @relation("UserReferrals")

  // Fraud signals captured at signup
  signupIp     String?
  signupDevice String?

  loyaltyPoints Int    @default(0)
  loyaltyTier   String @default("silver") // silver | gold | platinum | titanium
  /// Drives tier promotion. Only delivered orders count toward it.
  lifetimeSpendPaise Int @default(0)

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sessions          Session[]
  oauthAccounts     OAuthAccount[]
  addresses         Address[]
  savedCards        SavedCard[]
  savedUpis         SavedUpi[]
  bankAccounts      BankAccount[]
  wallet            Wallet?
  carts             Cart[]
  orders            Order[]
  reviews           Review[]
  stockAlerts       StockAlert[]
  referralsMade     Referral[]           @relation("Referrer")
  referralAsReferee Referral?            @relation("Referee")
  commissionsEarned ReferralCommission[] @relation("CommissionReferrer")
  withdrawals       WithdrawalRequest[]
  serviceRequests   ServiceRequest[]
  supportTickets    SupportTicket[]      @relation("TicketOwner")
  assignedTickets   SupportTicket[]      @relation("TicketAssignee")
  supportMessages   SupportMessage[]
  couponRedemptions CouponRedemption[]
  loyaltyTxns       LoyaltyTransaction[]
  auditLogs         AuditLog[]
  approvedPayouts   WithdrawalRequest[]  @relation("PayoutApprover")

  @@index([role])
  @@index([referredById])
  @@index([createdAt])
}

model StaffRole {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  /// JSON array of permission keys, e.g. ["orders.read","orders.write"]
  permissions String   @default("[]")
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jti       String   @unique
  ip        String?
  userAgent String?
  device    String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String // google | apple
  providerAccountId String
  email             String?
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model OtpCode {
  id         String    @id @default(cuid())
  identifier String // phone or email
  channel    String // sms | email
  purpose    String // login | signup | reset | verify_phone
  codeHash   String
  attempts   Int       @default(0)
  maxAttempts Int      @default(5)
  expiresAt  DateTime
  consumedAt DateTime?
  ip         String?
  createdAt  DateTime  @default(now())

  @@index([identifier, purpose])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ─────────────────────────── ADDRESSES & PAYMENT INSTRUMENTS ───────────

model Address {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String  @default("home") // home | work | other
  fullName  String
  phone     String
  altPhone  String?
  line1     String
  line2     String?
  landmark  String?
  city      String
  state     String
  pincode   String
  country   String  @default("India")
  latitude  Float?
  longitude Float?
  isDefault Boolean @default(false)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([userId])
  @@index([pincode])
}

/// PCI-safe: we persist only the gateway token + display metadata. Never PAN/CVV.
model SavedCard {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gatewayToken  String
  gateway       String   @default("razorpay")
  last4         String
  network       String // visa | mastercard | rupay | amex
  issuer        String?
  cardType      String // credit | debit
  holderName    String?
  expiryMonth   Int
  expiryYear    Int
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([userId])
}

model SavedUpi {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vpa        String
  handleName String?
  isVerified Boolean  @default(false)
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([userId, vpa])
}

/// Payout destination. Requires successful penny-drop before withdrawals unlock.
model BankAccount {
  id            String  @id @default(cuid())
  userId        String
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  destinationType String @default("bank") // bank | vpa
  accountHolder String
  accountNumber String? // stored masked except last 4 in `last4`
  last4         String?
  ifsc          String?
  bankName      String?
  branch        String?
  vpa           String?

  // Verification state machine: unverified → pending → verified | failed
  verificationStatus String    @default("unverified")
  verifiedAt         DateTime?
  nameMatchScore     Float?
  registeredName     String?
  failureReason      String?
  attempts           Int       @default(0)

  /// Provider-side ids from the verification step, reused when paying out so
  /// the money goes to exactly the account that passed the penny drop.
  providerContactId     String?
  providerFundAccountId String?
  /// Ref id of the in-flight verification we are polling.
  pendingVerificationRef String?

  isDefault Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  verificationLogs BankVerificationLog[]
  withdrawals      WithdrawalRequest[]

  @@index([userId])
  @@index([verificationStatus])
}

model BankVerificationLog {
  id            String   @id @default(cuid())
  bankAccountId String
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  provider      String // razorpay_fav | cashfree | decentro | mock
  providerRefId String?
  requestType   String   @default("penny_drop") // penny_drop | ifsc_validate | vpa_validate
  status        String // created | pending | completed | failed
  amountPaise   Int      @default(100)
  registeredName String?
  nameMatchScore Float?
  responseCode  String?
  message       String?
  rawResponse   String? // JSON
  attemptNo     Int      @default(1)
  createdAt     DateTime @default(now())
  completedAt   DateTime?

  @@index([bankAccountId])
  @@index([status])
}

// ─────────────────────────── CATALOG ───────────────────────────────────

model Brand {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  logoText  String? // wordmark fallback (no binary assets)
  accent    String   @default("#22d3ee")
  country   String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  products      Product[]
  emiPlans      EmiPlan[]
  serviceCenters ServiceCenterBrand[]
}

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  icon      String?
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)

  seoTitle       String?
  seoDescription String?

  products Product[]
}

model Product {
  id         String  @id @default(cuid())
  name       String
  slug       String  @unique
  tagline    String?
  description String?
  brandId    String
  brand      Brand   @relation(fields: [brandId], references: [id])
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  kind   String @default("phone") // phone | accessory | wearable | audio | tablet
  status String @default("active") // draft | active | archived | coming_soon

  // Pricing anchors (variants may override)
  mrpPaise   Int
  pricePaise Int

  // Launch / pre-order
  launchDate       DateTime?
  isPreorder       Boolean   @default(false)
  preorderReleaseAt DateTime?
  preorderDepositPaise Int?

  // Tax
  hsnCode String @default("85171300")
  gstRate Int    @default(18) // whole percent

  warrantyMonths Int @default(12)

  // Media
  heroGradient String  @default("from-cyan-500/30 to-blue-600/10")
  imageUrl     String?
  unboxingVideoUrl String?
  reviewVideoUrl   String?

  /// JSON array of highlight strings
  highlights String @default("[]")
  /// JSON array of badge strings e.g. ["5G","AI"]
  badges     String @default("[]")

  ratingAvg   Float @default(0)
  reviewCount Int   @default(0)
  soldCount   Int   @default(0)
  viewCount   Int   @default(0)

  isFeatured Boolean @default(false)
  sortOrder  Int     @default(0)

  seoTitle       String?
  seoDescription String?
  seoKeywords    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants     ProductVariant[]
  specValues   ProductSpecValue[]
  reviews      Review[]
  stockAlerts  StockAlert[]
  accessories  AccessoryLink[]  @relation("MainProduct")
  accessoryFor AccessoryLink[]  @relation("AccessoryProduct")
  exchangeModels ExchangeDevice[]

  @@index([brandId])
  @@index([categoryId])
  @@index([status])
  @@index([kind])
  @@index([isFeatured])
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  sku       String  @unique
  ramGb     Int?
  storageGb Int?
  colorName String
  colorHex  String
  colorHex2 String? // secondary stop for gradient/duotone finishes
  finish    String? // matte | glossy | titanium | ceramic
  imageUrl  String?

  mrpPaise   Int
  pricePaise Int

  weightGrams Int?
  isActive    Boolean @default(true)
  isDefault   Boolean @default(false)
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stocks         InventoryStock[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  stockMovements StockMovement[]
  poItems        PurchaseOrderItem[]
  flashSaleItems FlashSaleItem[]
  stockAlerts    StockAlert[]

  @@index([productId])
  @@index([isActive])
}

/// Spec-sheet builder: admin defines attributes once, products fill values.
model SpecDefinition {
  id            String  @id @default(cuid())
  key           String  @unique
  label         String
  groupName     String  @default("General") // Display | Performance | Camera | Battery
  unit          String?
  dataType      String  @default("text") // text | number | boolean | enum
  /// JSON array of allowed values when dataType = enum
  options       String  @default("[]")
  isFilterable  Boolean @default(false)
  isComparable  Boolean @default(true)
  isKeySpec     Boolean @default(false) // shown on tiles
  higherIsBetter Boolean @default(true)
  /// upper bound used to normalise animated comparison bars
  scaleMax      Float?
  sortOrder     Int     @default(0)

  values ProductSpecValue[]
}

model ProductSpecValue {
  id           String  @id @default(cuid())
  productId    String
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  definitionId String
  definition   SpecDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  valueText    String?
  valueNumber  Float?
  valueBool    Boolean?

  @@unique([productId, definitionId])
  @@index([definitionId])
}

model AccessoryLink {
  id            String  @id @default(cuid())
  productId     String
  product       Product @relation("MainProduct", fields: [productId], references: [id], onDelete: Cascade)
  accessoryId   String
  accessory     Product @relation("AccessoryProduct", fields: [accessoryId], references: [id], onDelete: Cascade)
  bundleDiscountPct Int  @default(0)
  sortOrder     Int     @default(0)

  @@unique([productId, accessoryId])
}

model Review {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?   @relation(fields: [userId], references: [id])
  orderId   String?

  rating  Int
  title   String?
  body    String
  /// JSON map of sub-ratings e.g. {"camera":5,"battery":4}
  aspects String  @default("{}")

  isVerifiedPurchase Boolean @default(false)
  isExpert           Boolean @default(false)
  expertName         String?
  expertOutlet       String?

  status       String  @default("pending") // pending | approved | rejected
  isFlaggedFake Boolean @default(false)
  /// JSON array of automated fraud signals
  fraudSignals String  @default("[]")
  moderatorNote String?
  moderatedById String?
  moderatedAt   DateTime?

  helpfulCount Int @default(0)
  reportCount  Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, status])
  @@index([status])
  @@index([userId])
}

model StockAlert {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  userId    String?
  user      User?   @relation(fields: [userId], references: [id])
  email     String?
  phone     String?
  notifiedAt DateTime?
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([notifiedAt])
}

// ─────────────────────────── PRICING ENGINE ────────────────────────────

model PricingRule {
  id       String @id @default(cuid())
  name     String
  scope    String // global | brand | category | product | variant
  targetId String?
  discountType String // percent | flat | fixed_price
  value    Int // percent whole number, or paise
  maxDiscountPaise Int?
  priority Int      @default(0)
  startsAt DateTime?
  endsAt   DateTime?
  isActive Boolean  @default(true)
  /// JSON conditions, e.g. {"minQty":2,"loyaltyTier":"gold"}
  conditions String @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scope, isActive])
}

model FlashSale {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  startsAt  DateTime
  endsAt    DateTime
  isActive  Boolean  @default(true)
  bannerText String?
  createdAt DateTime @default(now())

  items FlashSaleItem[]

  @@index([startsAt, endsAt])
}

model FlashSaleItem {
  id          String @id @default(cuid())
  flashSaleId String
  flashSale   FlashSale @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  salePricePaise Int
  quantityCap Int  @default(0) // 0 = unlimited
  soldCount   Int  @default(0)

  @@unique([flashSaleId, variantId])
}

model EmiPlan {
  id           String  @id @default(cuid())
  bankName     String
  bankCode     String
  brandId      String?
  brand        Brand?  @relation(fields: [brandId], references: [id])
  tenureMonths Int
  /// annual interest rate in basis points (1200 = 12.00%)
  interestBps  Int     @default(0)
  isNoCost     Boolean @default(false)
  minOrderPaise Int    @default(500000)
  processingFeePaise Int @default(0)
  /// JSON array: ["credit","debit","cardless"]
  instruments  String  @default("[\"credit\"]")
  isActive     Boolean @default(true)
  sortOrder    Int     @default(0)

  @@index([bankCode])
  @@index([isActive])
}

/// Trade-in valuation table for the exchange estimator.
model ExchangeDevice {
  id        String   @id @default(cuid())
  brandName String
  modelName String
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  baseValuePaise Int
  launchYear Int?
  isActive  Boolean  @default(true)

  @@unique([brandName, modelName])
}

model Coupon {
  id          String   @id @default(cuid())
  code        String   @unique
  description String?
  discountType String // percent | flat
  value       Int
  maxDiscountPaise Int?
  minOrderPaise    Int @default(0)
  usageLimit  Int      @default(0) // 0 = unlimited
  perUserLimit Int     @default(1)
  usedCount   Int      @default(0)
  startsAt    DateTime?
  endsAt      DateTime?
  isActive    Boolean  @default(true)
  /// JSON: {"brandIds":[],"categoryIds":[],"productIds":[]}
  appliesTo   String   @default("{}")
  isSignupCoupon   Boolean @default(false)
  isReferralReward Boolean @default(false)
  isStackable      Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  redemptions CouponRedemption[]
}

model CouponRedemption {
  id       String  @id @default(cuid())
  couponId String
  coupon   Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId  String?
  order    Order?  @relation(fields: [orderId], references: [id])
  discountPaise Int
  createdAt DateTime @default(now())

  @@index([couponId])
  @@index([userId])
}

// ─────────────────────────── CART & CHECKOUT ───────────────────────────

model ProtectionPlan {
  id          String  @id @default(cuid())
  name        String
  tier        String // basic | plus | total
  description String?
  durationMonths Int
  priceType   String  @default("percent") // percent | flat
  priceValue  Int
  /// JSON array of covered scenarios
  coverage    String  @default("[]")
  appliesToKind String @default("phone")
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  cartItems  CartItem[]
  orderItems OrderItem[]
}

model Cart {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?
  couponCode String?
  status    String   @default("active") // active | converted | abandoned
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items          CartItem[]
  abandonedCart  AbandonedCart?

  @@index([userId])
  @@index([sessionId])
  @@index([status, updatedAt])
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  cart      Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int    @default(1)
  protectionPlanId String?
  protectionPlan   ProtectionPlan? @relation(fields: [protectionPlanId], references: [id])
  isAccessory Boolean @default(false)
  addedAt   DateTime @default(now())

  @@unique([cartId, variantId, protectionPlanId])
  @@index([cartId])
}

// ─────────────────────────── ORDERS ────────────────────────────────────

model Order {
  id      String @id @default(cuid())
  orderNo String @unique
  userId  String
  user    User   @relation(fields: [userId], references: [id])

  status        String @default("pending") // pending|confirmed|packed|shipped|out_for_delivery|delivered|cancelled|returned
  paymentStatus String @default("pending") // pending|paid|partially_paid|failed|refunded|partially_refunded
  fulfilmentType String @default("standard") // standard | express | preorder

  addressId       String?
  address         Address? @relation(fields: [addressId], references: [id])
  /// Immutable snapshot of the delivery address at order time
  addressSnapshot String

  // Money (paise)
  subtotalPaise      Int
  discountPaise      Int @default(0)
  couponCode         String?
  couponDiscountPaise Int @default(0)
  exchangeCreditPaise Int @default(0)
  protectionPaise    Int @default(0)
  shippingPaise      Int @default(0)
  codFeePaise        Int @default(0)
  taxablePaise       Int @default(0)
  taxPaise           Int @default(0)
  walletAppliedPaise Int @default(0)
  totalPaise         Int
  amountPaidPaise    Int @default(0)
  amountDuePaise     Int @default(0)
  refundedPaise      Int @default(0)

  paymentMethod String? // cod | card | upi | netbanking | wallet | emi | wallet_full
  emiPlanId     String?
  emiTenure     Int?
  emiMonthlyPaise Int?

  courier     String?
  awb         String?
  trackingUrl String?
  expectedDeliveryAt DateTime?
  deliveredAt DateTime?

  placedAt    DateTime  @default(now())
  confirmedAt DateTime?
  cancelledAt DateTime?
  cancelReason String?
  cancelledBy  String? // customer | admin | system

  // Referral attribution guard — ensures commission is credited exactly once
  referralProcessedAt DateTime?

  ipAddress String?
  deviceId  String?
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items        OrderItem[]
  events       OrderStatusEvent[]
  payments     PaymentAttempt[]
  refunds      Refund[]
  invoice      Invoice?
  shipments    Shipment[]
  commissions  ReferralCommission[]
  redemptions  CouponRedemption[]
  serviceRequests ServiceRequest[]
  supportTickets  SupportTicket[]
  emiSchedule  EmiInstalment[]
  walletTxns   WalletTransaction[]

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([placedAt])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  // Snapshots — order lines must never mutate when the catalog changes
  productName String
  brandName   String
  variantLabel String
  sku         String
  imageGradient String?

  quantity      Int
  mrpPaise      Int
  unitPricePaise Int
  discountPaise Int @default(0)
  hsnCode       String
  gstRate       Int
  taxablePaise  Int
  taxPaise      Int
  lineTotalPaise Int

  protectionPlanId String?
  protectionPlan   ProtectionPlan? @relation(fields: [protectionPlanId], references: [id])
  protectionName   String?
  protectionPaise  Int @default(0)

  warrantyMonths Int @default(12)
  isAccessory    Boolean @default(false)

  units OrderUnit[]

  @@index([orderId])
}

/// One row per physical unit sold — carries the IMEI/serial the customer receives.
model OrderUnit {
  id          String @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  imei1        String? @unique
  imei2        String?
  serialNumber String? @unique
  warehouseId  String?
  warehouse    Warehouse? @relation(fields: [warehouseId], references: [id])
  warrantyStart DateTime?
  warrantyEnd   DateTime?
  status       String  @default("allocated") // allocated | dispatched | delivered | returned | replaced
  createdAt    DateTime @default(now())

  warrantyCard WarrantyCard?
  serviceRequests ServiceRequest[]

  @@index([orderItemId])
}

model OrderStatusEvent {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status  String
  note    String?
  location String?
  actorId String?
  actorType String @default("system") // system | admin | customer | courier
  createdAt DateTime @default(now())

  @@index([orderId])
}

model Shipment {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courier String
  awb     String
  status  String @default("created")
  labelUrl String?
  manifestId String?
  shippedAt   DateTime?
  deliveredAt DateTime?
  createdAt   DateTime @default(now())

  @@index([orderId])
}

/// GST-compliant tax invoice.
model Invoice {
  id        String @id @default(cuid())
  orderId   String @unique
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  invoiceNo String @unique
  irn       String?
  sellerGstin String
  sellerName  String
  sellerState String
  buyerName   String
  buyerGstin  String?
  placeOfSupply String
  isInterState  Boolean @default(false)
  taxablePaise Int
  cgstPaise    Int @default(0)
  sgstPaise    Int @default(0)
  igstPaise    Int @default(0)
  cessPaise    Int @default(0)
  roundOffPaise Int @default(0)
  totalPaise   Int
  /// JSON: HSN-wise tax summary rows
  hsnSummary   String @default("[]")
  issuedAt     DateTime @default(now())

  @@index([invoiceNo])
}

model WarrantyCard {
  id          String @id @default(cuid())
  orderUnitId String @unique
  orderUnit   OrderUnit @relation(fields: [orderUnitId], references: [id], onDelete: Cascade)
  cardNo      String @unique
  productName String
  imei        String?
  months      Int
  validFrom   DateTime
  validTill   DateTime
  isExtended  Boolean @default(false)
  issuedAt    DateTime @default(now())
}

/// EMI amortisation rows — powers the customer "EMI status tracker".
model EmiInstalment {
  id        String @id @default(cuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seqNo     Int
  dueDate   DateTime
  amountPaise Int
  principalPaise Int
  interestPaise  Int
  status    String @default("upcoming") // upcoming | paid | overdue | failed
  paidAt    DateTime?

  @@unique([orderId, seqNo])
}

// ─────────────────────────── PAYMENTS ──────────────────────────────────

model PaymentAttempt {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  gateway         String  @default("mock") // mock | razorpay
  gatewayOrderId  String?
  gatewayPaymentId String? @unique
  method          String // card | upi | netbanking | wallet | emi | cod
  instrumentLabel String? // "HDFC •••• 4242" / "user@upi"
  amountPaise     Int
  currency        String  @default("INR")

  status String @default("created") // created|pending|authorized|captured|failed|refunded
  errorCode        String?
  errorDescription String?
  /// JSON of the gateway response for reconciliation
  rawPayload String?
  attemptNo  Int @default(1)
  isRetryOf  String?

  createdAt   DateTime  @default(now())
  capturedAt  DateTime?
  failedAt    DateTime?

  refunds Refund[]

  @@index([orderId])
  @@index([status])
  @@index([gateway])
}

model Refund {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentAttemptId String?
  paymentAttempt   PaymentAttempt? @relation(fields: [paymentAttemptId], references: [id])
  amountPaise Int
  reason      String?
  mode        String @default("gateway") // gateway | wallet
  status      String @default("initiated") // initiated | processing | completed | failed
  gatewayRefundId String?
  speed       String @default("normal")
  createdAt   DateTime @default(now())
  processedAt DateTime?

  @@index([orderId])
}

model WebhookEvent {
  id        String   @id @default(cuid())
  gateway   String
  eventId   String   @unique
  eventType String
  payload   String
  signatureValid Boolean @default(false)
  processedAt DateTime?
  error     String?
  createdAt DateTime @default(now())

  @@index([eventType])
}

model PincodeServiceability {
  id        String  @id @default(cuid())
  pincode   String  @unique
  city      String
  state     String
  zone      String  @default("metro") // metro | tier1 | tier2 | remote
  isServiceable Boolean @default(true)
  codAvailable  Boolean @default(true)
  codLimitPaise Int     @default(5000000)
  expressAvailable Boolean @default(false)
  deliveryDays  Int     @default(3)
  updatedAt DateTime @updatedAt

  @@index([codAvailable])
}

// ─────────────────────────── WALLET & PAYOUTS ──────────────────────────

/// Points ledger. Kept separate from the wallet because points are not money:
/// they convert at an admin-set rate and never become withdrawable cash.
model LoyaltyTransaction {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId String?
  points  Int
  /// earn | redeem | expire | adjustment
  direction   String
  description String
  balanceAfter Int @default(0)
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model Wallet {
  id      String @id @default(cuid())
  userId  String @unique
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Withdrawable + spendable now
  balancePaise Int @default(0)
  /// Credited but inside the return/cancellation hold window
  pendingPaise Int @default(0)
  /// Reserved against an in-flight withdrawal
  lockedPaise  Int @default(0)
  currency String @default("INR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions WalletTransaction[]
}

model WalletTransaction {
  id       String @id @default(cuid())
  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  /// referral_commission | cashback | refund | order_payment | withdrawal | adjustment | reversal | signup_bonus
  type      String
  direction String // credit | debit
  amountPaise Int
  balanceAfterPaise Int

  /// pending (in hold) | available | processing | completed | failed | reversed
  status String @default("completed")

  referenceType String? // order | referral_commission | withdrawal | manual
  referenceId   String?
  orderId       String?
  order         Order?  @relation(fields: [orderId], references: [id])
  description   String
  /// When a held credit becomes withdrawable
  availableAt   DateTime?
  createdById   String? // admin, for manual adjustments
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  commission ReferralCommission?
  withdrawal WithdrawalRequest?

  @@index([walletId, createdAt])
  @@index([type])
  @@index([status, availableAt])
}

model WithdrawalRequest {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestNo String @unique

  amountPaise Int
  destinationType String @default("bank") // bank | vpa
  bankAccountId String?
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id])
  /// Destination snapshot at request time
  destinationSnapshot String

  walletTxnId String? @unique
  walletTxn   WalletTransaction? @relation(fields: [walletTxnId], references: [id])

  /// requested | approved | rejected | processing | completed | failed | cancelled
  status String @default("requested")
  isAutoApproved Boolean @default(false)
  approvedById String?
  approvedBy   User?  @relation("PayoutApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  rejectionReason String?
  adminNote    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payouts Payout[]

  @@index([userId])
  @@index([status])
}

model Payout {
  id String @id @default(cuid())
  withdrawalRequestId String
  withdrawalRequest   WithdrawalRequest @relation(fields: [withdrawalRequestId], references: [id], onDelete: Cascade)

  provider   String @default("mock") // mock | razorpayx | cashfree
  providerPayoutId String?
  mode       String @default("IMPS") // IMPS | NEFT | UPI | RTGS
  amountPaise Int
  feePaise    Int @default(0)
  taxPaise    Int @default(0)
  /// created | queued | processing | processed | reversed | failed | cancelled
  status     String @default("created")
  utr        String?
  failureReason String?
  rawResponse String?
  attemptNo  Int @default(1)
  createdAt  DateTime @default(now())
  processedAt DateTime?

  @@index([withdrawalRequestId])
  @@index([status])
}

// ─────────────────────────── REFERRAL ENGINE ───────────────────────────

model ReferralRule {
  id   String @id @default(cuid())
  name String
  /// percent | flat
  commissionType  String @default("percent")
  /// whole percent, or paise when flat
  commissionValue Int
  maxCommissionPaise Int?
  /// first_order_only | recurring
  appliesTo       String @default("first_order_only")
  minOrderPaise   Int    @default(100000)
  /// days a commission is held before becoming withdrawable
  holdDays        Int    @default(15)
  /// tier slab: rule applies once referrer has >= this many conversions
  tierMinConversions Int @default(0)
  tierLabel       String?
  /// coupon auto-issued to the referred user
  refereeCouponCode String?
  isActive        Boolean @default(true)
  priority        Int     @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  commissions ReferralCommission[]

  @@index([isActive, tierMinConversions])
}

model Referral {
  id         String @id @default(cuid())
  referrerId String
  referrer   User   @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  refereeId  String @unique
  referee    User   @relation("Referee", fields: [refereeId], references: [id], onDelete: Cascade)
  code       String

  /// invited | signed_up | converted
  status      String @default("signed_up")
  signedUpAt  DateTime @default(now())
  firstOrderId String?
  convertedAt DateTime?

  // Fraud signals
  signupIp     String?
  signupDevice String?
  /// JSON array e.g. ["same_ip","same_device"]
  fraudFlags   String  @default("[]")
  riskScore    Int     @default(0)
  isBlocked    Boolean @default(false)
  blockReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  commissions ReferralCommission[]

  @@index([referrerId])
  @@index([status])
}

model ReferralCommission {
  id         String   @id @default(cuid())
  referralId String
  referral   Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  referrerId String
  referrer   User     @relation("CommissionReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  refereeId  String
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ruleId     String?
  rule       ReferralRule? @relation(fields: [ruleId], references: [id])

  orderValuePaise  Int
  commissionPaise  Int
  /// pending | held | unlocked | paid | reversed | rejected
  status     String   @default("held")
  unlockAt   DateTime?
  walletTxnId String? @unique
  walletTxn   WalletTransaction? @relation(fields: [walletTxnId], references: [id])

  isAdminAdjusted Boolean @default(false)
  originalPaise   Int?
  adminNote       String?
  adjustedById    String?
  reversedReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, referrerId])
  @@index([referrerId, status])
  @@index([status, unlockAt])
}

// ─────────────────────────── WARRANTY / SERVICE / SUPPORT ──────────────

model ServiceCenter {
  id       String @id @default(cuid())
  name     String
  code     String @unique
  addressLine String
  city     String
  state    String
  pincode  String
  latitude  Float?
  longitude Float?
  phone    String
  email    String?
  openHours String @default("10:00–19:00, Mon–Sat")
  dailyCapacity Int @default(20)
  isAuthorized Boolean @default(true)
  isActive Boolean @default(true)

  brands   ServiceCenterBrand[]
  requests ServiceRequest[]

  @@index([pincode])
  @@index([city])
}

model ServiceCenterBrand {
  id String @id @default(cuid())
  serviceCenterId String
  serviceCenter   ServiceCenter @relation(fields: [serviceCenterId], references: [id], onDelete: Cascade)
  brandId String
  brand   Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([serviceCenterId, brandId])
}

/// RMA / repair / replacement workflow.
model ServiceRequest {
  id       String @id @default(cuid())
  ticketNo String @unique
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId  String?
  order    Order? @relation(fields: [orderId], references: [id])
  orderUnitId String?
  orderUnit   OrderUnit? @relation(fields: [orderUnitId], references: [id])

  /// repair | replacement | return | inspection
  type String
  issueCategory String? // screen | battery | camera | software | water_damage | other
  issueDescription String
  isUnderWarranty Boolean @default(true)

  /// requested|approved|rejected|pickup_scheduled|received|diagnosing|awaiting_parts|repairing|repaired|replaced|shipped_back|closed|cancelled
  status String @default("requested")
  serviceCenterId String?
  serviceCenter   ServiceCenter? @relation(fields: [serviceCenterId], references: [id])
  assignedToId String?

  diagnosis    String?
  estimatedCostPaise Int?
  actualCostPaise    Int?
  replacementImei    String?

  receivedAt  DateTime?
  completedAt DateTime?
  slaDueAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events ServiceEvent[]

  @@index([userId])
  @@index([status])
  @@index([serviceCenterId])
}

model ServiceEvent {
  id String @id @default(cuid())
  serviceRequestId String
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  status String
  note   String?
  actorId String?
  createdAt DateTime @default(now())

  @@index([serviceRequestId])
}

model SupportTicket {
  id       String @id @default(cuid())
  ticketNo String @unique
  userId   String
  user     User   @relation("TicketOwner", fields: [userId], references: [id], onDelete: Cascade)
  orderId  String?
  order    Order? @relation(fields: [orderId], references: [id])
  subject  String
  category String @default("general") // order | payment | wallet | product | general
  priority String @default("normal") // low | normal | high | urgent
  status   String @default("open") // open | pending | resolved | closed
  assignedToId String?
  assignedTo   User? @relation("TicketAssignee", fields: [assignedToId], references: [id])
  firstResponseAt DateTime?
  resolvedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages SupportMessage[]

  @@index([userId])
  @@index([status])
}

model SupportMessage {
  id       String @id @default(cuid())
  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId String?
  author   User?  @relation(fields: [authorId], references: [id])
  isStaff  Boolean @default(false)
  body     String
  createdAt DateTime @default(now())

  @@index([ticketId])
}

// ─────────────────────────── INVENTORY ─────────────────────────────────

model Warehouse {
  id      String @id @default(cuid())
  name    String
  code    String @unique
  addressLine String
  city    String
  state   String
  pincode String
  gstin   String?
  priority Int    @default(0)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())

  stocks    InventoryStock[]
  movements StockMovement[]
  pos       PurchaseOrder[]
  units     OrderUnit[]
}

model InventoryStock {
  id          String @id @default(cuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity    Int @default(0)
  reserved    Int @default(0)
  damaged     Int @default(0)
  lowStockThreshold Int @default(5)
  updatedAt   DateTime @updatedAt

  @@unique([warehouseId, variantId])
  @@index([variantId])
}

model StockMovement {
  id          String @id @default(cuid())
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  /// inbound | outbound | transfer | adjustment | return | damage
  type     String
  quantity Int
  reason   String?
  referenceType String?
  referenceId   String?
  actorId  String?
  createdAt DateTime @default(now())

  @@index([variantId])
  @@index([createdAt])
}

model Supplier {
  id      String @id @default(cuid())
  name    String
  code    String @unique
  gstin   String?
  contactName String?
  phone   String?
  email   String?
  addressLine String?
  city    String?
  state   String?
  paymentTermsDays Int @default(30)
  rating  Float @default(4)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())

  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id     String @id @default(cuid())
  poNo   String @unique
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  /// draft | sent | partially_received | received | cancelled
  status String @default("draft")
  expectedAt DateTime?
  receivedAt DateTime?
  subtotalPaise Int @default(0)
  taxPaise      Int @default(0)
  totalPaise    Int @default(0)
  notes  String?
  createdById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items PurchaseOrderItem[]

  @@index([status])
}

model PurchaseOrderItem {
  id     String @id @default(cuid())
  poId   String
  po     PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity     Int
  receivedQty  Int @default(0)
  unitCostPaise Int
  gstRate      Int @default(18)

  @@index([poId])
}

// ─────────────────────────── MARKETING / CMS ───────────────────────────

model Banner {
  id       String @id @default(cuid())
  title    String
  subtitle String?
  eyebrow  String?
  ctaLabel String?
  ctaHref  String?
  /// tailwind gradient classes — keeps the build asset-free
  gradient String @default("from-cyan-500/25 via-blue-600/10 to-transparent")
  accent   String @default("#22d3ee")
  placement String @default("hero") // hero | strip | category | pdp
  sortOrder Int    @default(0)
  startsAt DateTime?
  endsAt   DateTime?
  isActive Boolean @default(true)
  clickCount Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([placement, isActive])
}

model HomepageSection {
  id       String @id @default(cuid())
  key      String @unique
  type     String // hero | featured | flash_sale | brand_rail | comparison | launch_countdown | testimonial | category_grid
  title    String?
  subtitle String?
  /// JSON config consumed by the renderer
  config   String @default("{}")
  sortOrder Int    @default(0)
  isActive Boolean @default(true)
  updatedAt DateTime @updatedAt
}

model PushNotification {
  id      String @id @default(cuid())
  title   String
  body    String
  /// all | loyalty_tier | abandoned_cart | segment_query
  segment String @default("all")
  segmentConfig String @default("{}")
  deepLink String?
  scheduledAt DateTime?
  sentAt   DateTime?
  status   String @default("draft") // draft | scheduled | sent | failed
  audienceCount Int @default(0)
  deliveredCount Int @default(0)
  openCount Int @default(0)
  createdById String?
  createdAt DateTime @default(now())
}

model AbandonedCart {
  id     String @id @default(cuid())
  cartId String @unique
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)
  userId String?
  email  String?
  phone  String?
  valuePaise Int
  itemCount  Int @default(0)
  reminderCount Int @default(0)
  lastReminderAt DateTime?
  recoveredOrderId String?
  /// open | reminded | recovered | lost
  status String @default("open")
  couponIssued String?
  detectedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
}

model CmsPage {
  id      String @id @default(cuid())
  slug    String @unique
  title   String
  content String
  seoTitle String?
  seoDescription String?
  isPublished Boolean @default(false)
  updatedAt DateTime @updatedAt
}

// ─────────────────────────── ANALYTICS ─────────────────────────────────

model TrafficEvent {
  id        String @id @default(cuid())
  path      String
  eventType String @default("pageview") // pageview | add_to_cart | begin_checkout | purchase | search
  sessionId String?
  userId    String?
  referrer  String?
  device    String @default("desktop") // desktop | mobile | tablet
  source    String? // direct | organic | referral | social | paid
  productId String?
  valuePaise Int?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([eventType])
}

/// Pre-aggregated rollups so the dashboard never scans raw events.
model DailyMetric {
  id       String   @id @default(cuid())
  date     DateTime @unique
  revenuePaise Int  @default(0)
  orderCount   Int  @default(0)
  unitCount    Int  @default(0)
  visitors     Int  @default(0)
  sessions     Int  @default(0)
  addToCarts   Int  @default(0)
  checkouts    Int  @default(0)
  returnCount  Int  @default(0)
  cancelCount  Int  @default(0)
  codOrders    Int  @default(0)
  onlineOrders Int  @default(0)
  newUsers     Int  @default(0)
}

// ─────────────────────────── SETTINGS & OPS ────────────────────────────

model Setting {
  id        String @id @default(cuid())
  key       String @unique
  /// JSON-encoded value
  value     String
  groupName String @default("general") // general | payment | shipping | tax | seo | theme | referral | wallet
  label     String?
  isSecret  Boolean @default(false)
  updatedAt DateTime @updatedAt

  @@index([groupName])
}

model ShippingZone {
  id      String @id @default(cuid())
  name    String
  /// JSON array of state names
  states  String @default("[]")
  /// JSON array of pincode prefixes
  pincodePrefixes String @default("[]")
  baseRatePaise Int @default(0)
  freeAbovePaise Int @default(4999900)
  codFeePaise   Int @default(4900)
  expressRatePaise Int @default(19900)
  deliveryDays  Int @default(3)
  isActive Boolean @default(true)
  sortOrder Int @default(0)
}

model TaxRule {
  id       String @id @default(cuid())
  name     String
  hsnCode  String
  gstRate  Int
  cessRate Int    @default(0)
  categorySlug String?
  isActive Boolean @default(true)

  @@index([hsnCode])
}

model AuditLog {
  id      String @id @default(cuid())
  actorId String?
  actor   User?  @relation(fields: [actorId], references: [id])
  actorEmail String?
  action  String // e.g. "order.cancel", "payout.approve"
  entity  String
  entityId String?
  /// JSON before/after snapshots
  before  String?
  after   String?
  ip      String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

// ─────────────────────────── CHATBOT ───────────────────────────────────

model ChatSession {
  id        String @id @default(cuid())
  sessionId String @unique
  userId    String?
  /// JSON snapshot of extracted intent: {"budget":5000000,"priority":"camera"}
  context   String @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ChatMessage[]
}

model ChatMessage {
  id        String @id @default(cuid())
  chatSessionId String
  chatSession   ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
  role      String // user | assistant
  content   String
  /// JSON array of recommended product ids
  recommendations String @default("[]")
  createdAt DateTime @default(now())

  @@index([chatSessionId])
}
