# ─────────────────────────────────────────────────────────────
# VOLTAGE — environment
# ─────────────────────────────────────────────────────────────
DATABASE_URL="file:./dev.db"

# Session signing secret (change in production)
AUTH_SECRET="voltage-dev-secret-change-me-in-production-0123456789abcdef"

# ── Gateway drivers ──────────────────────────────────────────
# "mock"     → deterministic in-process simulator (default, no keys needed)
# "razorpay" → live Razorpay Payments + RazorpayX Payouts + Fund Account Validation
PAYMENT_DRIVER="mock"
PAYOUT_DRIVER="mock"
VERIFICATION_DRIVER="mock"

# ── Razorpay (only read when a driver above is set to "razorpay") ──
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# RazorpayX account from which payouts debit (e.g. 2323230000000000)
RAZORPAYX_ACCOUNT_NUMBER=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# ── OAuth (social login). Empty = button shows "not configured". ──
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# ── OTP / email delivery ─────────────────────────────────────
# "console" → OTP printed to server log AND returned to the client in dev
OTP_DRIVER="console"
MAIL_DRIVER="console"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
