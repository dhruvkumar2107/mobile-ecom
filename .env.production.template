# ════════════════════════════════════════════════════════════════════════
# VOLTAGE — Production Environment Template
# ════════════════════════════════════════════════════════════════════════
# Copy this file to .env.production and fill in all values.
# NEVER commit the actual .env.production file to version control.
# ════════════════════════════════════════════════════════════════════════

# ────────────────────────────────────────────────────────────────────────
# Core
# ────────────────────────────────────────────────────────────────────────
NODE_ENV=production
# The Prisma datasource provider is "sqlite", so there are two supported
# backends. Switching to PostgreSQL would mean changing the provider and
# reworking the JSON/enum-ish column conventions -- it is not a URL swap.
#
#  1. Serverless hosts (Vercel, Netlify, Lambda) -- REQUIRED.
#     The function filesystem is read-only outside /tmp and is discarded
#     between invocations, so a "file:" database is neither writable nor
#     reliably present at request time. Use hosted libSQL (Turso), which is
#     wire-compatible with SQLite, so schema and seed are unchanged.
#     Setting TURSO_DATABASE_URL is what routes src/lib/db.ts to the adapter;
#     DATABASE_URL is then only used by the Prisma CLI.
#
#       turso db create voltage
#       turso db show voltage --url        # -> libsql://...turso.io
#       turso db tokens create voltage     # -> auth token
#
# TURSO_DATABASE_URL="libsql://voltage-you.turso.io"
# TURSO_AUTH_TOKEN=""
#
#  2. Single-instance / container deploys, where the file lives on a
#     persistent volume that survives restarts.
DATABASE_URL="file:/data/prod.db"

# Must be at least 32 characters. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# ────────────────────────────────────────────────────────────────────────
# Public URL (used in emails, webhooks, OAuth redirects)
# ────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# ────────────────────────────────────────────────────────────────────────
# Payment Gateway — Razorpay (set PAYMENT_DRIVER=razorpay to enable)
# ────────────────────────────────────────────────────────────────────────
PAYMENT_DRIVER="razorpay"
PAYOUT_DRIVER="razorpay"
VERIFICATION_DRIVER="razorpay"

RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
RAZORPAYX_ACCOUNT_NUMBER=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# ────────────────────────────────────────────────────────────────────────
# OAuth Providers (optional — buttons show "not configured" if empty)
# ────────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# ────────────────────────────────────────────────────────────────────────
# OTP / Email Delivery (production requires real providers)
# ────────────────────────────────────────────────────────────────────────
# Options: "console" | "twilio" | "plivo" | "messagebird" | custom
OTP_DRIVER="twilio"
# Options: "console" | "sendgrid" | "postmark" | "ses" | "nodemailer" | custom
MAIL_DRIVER="sendgrid"

# Twilio (if OTP_DRIVER=twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_MESSAGING_SERVICE_SID=""

# SendGrid (if MAIL_DRIVER=sendgrid)
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL="noreply@your-domain.com"
SENDGRID_FROM_NAME="VOLTAGE"

# ────────────────────────────────────────────────────────────────────────
# Redis (optional — for rate-limiting, caching, sessions when scaling)
# ────────────────────────────────────────────────────────────────────────
# REDIS_URL="redis://localhost:6379"

# ────────────────────────────────────────────────────────────────────────
# Sentry / Error Tracking (optional)
# ────────────────────────────────────────────────────────────────────────
# SENTRY_DSN=""
# SENTRY_ORG=""
# SENTRY_PROJECT=""
# SENTRY_AUTH_TOKEN=""

# ────────────────────────────────────────────────────────────────────────
# Analytics (optional)
# ────────────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_GA_ID=""
# NEXT_PUBLIC_POSTHOG_KEY=""
# NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"